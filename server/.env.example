# ── Pathora / SkillSarthi MSDE backend secrets ─────────────────────────
# Copy this file to `.env` and fill in your values. Never commit `.env`.
#   cp .env.example .env
#
# The server reads these at boot. The frontend NEVER sees or sends keys.

# --- OPTION 1: Groq (Recommended: Fast & Reliable) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# --- OPTION 2: Google Gemini ---
# GEMINI_API_KEY=AIzaSy...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
# AI_GROUNDING=true

# Master switch for live AI. true = generate on the go when a key exists.
# false = API returns explicit errors (no silent dummy content).
AI_ENABLED=true
