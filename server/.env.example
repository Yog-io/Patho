# ── SkillSarthi / Patho MSDE backend secrets ─────────────────────────────
# Copy this file to `.env` and fill in your values. Never commit `.env`.
#   cp .env.example .env
#
# The server reads these at boot. The frontend NEVER sees or sends keys.

# Gemini API key (primary). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback key variable (used only if GEMINI_API_KEY is empty)
AI_API_KEY=

# OpenAI-compatible base URL. Gemini default below; for OpenAI use
# https://api.openai.com/v1, for Groq https://api.groq.com/openai/v1, etc.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model name, e.g. gemini-3.1-flash-lite, gemini-2.5-flash, gpt-4o-mini
AI_MODEL=gemini-3.1-flash-lite

# Master switch for live AI. true = generate on the go when a key exists.
# false = API returns explicit errors (no silent dummy content).
AI_ENABLED=true

# Live Google Search grounding for role + roadmap research.
# true = researched with sources; false = model knowledge only.
AI_GROUNDING=true
